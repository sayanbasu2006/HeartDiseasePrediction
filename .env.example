# FastAPI (export in your shell before starting the backend)
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# DATABASE_URL defaults to backend/history.sqlite
# DATABASE_URL=sqlite:////absolute/path/to/history.sqlite
# Frontend: copy BACKEND_URL to frontend/.env.local if needed.
BACKEND_URL=http://127.0.0.1:8000
NEXT_TELEMETRY_DISABLED=1
